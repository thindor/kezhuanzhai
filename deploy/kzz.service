[Unit]
Description=可转债持有人系统 (Kezhuanzhai, Flask + Gunicorn)
After=network.target

[Service]
Type=simple
# 运行用户：Ubuntu/Debian 常用 www-data；CentOS 可用 nginx 用户，按需修改
User=www-data
Group=www-data
WorkingDirectory=/opt/kezhuanzhai
# 从 .env 读取密钥与密码（文件权限应设为 600，属主 root，不入库）
EnvironmentFile=/opt/kezhuanzhai/.env
# Gunicorn：4 个工作进程，绑定本机 8000，由 nginx 反代（端口需与 nginx 配置一致）
ExecStart=/opt/kezhuanzhai/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
