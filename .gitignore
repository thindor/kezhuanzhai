# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
venv/
env/
.Python

# ---- 运行时数据库（本地采集结果，不入库；可重新爬取生成）----
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- 搜索索引缓存（app.py 启动时自动重建，无需入库）----
bond_index.json

# ---- 日志 ----
*.log
*.err

# ---- 旧版 / 备份模板（下划线前缀为历史备份，非线上模板）----
_*.html
!/templates/_nav.html   # 共用导航片段，非历史备份，必须入库（否则部署端 clone 后全站 500）

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 第三方 / 工具自动生成的规格文档（非项目源码，不入库）----
docs/superpowers/

# ---- 本地环境变量（如含密钥请勿入库）----
.env

# ---- 第三方登录凭据（雪球/集思录等 cookie，严禁入库）----
xueqiu_cookie.txt
jsl_cookie.txt
config_private.py

# ---- 临时探查 / 调试脚本（本地验证用，不入库）----
_probe_*.py
_probe_out.txt
tmp_*.py

# ---- 持有人手动刷新状态文件（运行时产生，非源码）----
holder_refresh_status.json

# ---- 集思录 Cookie 抓取状态文件（运行时产生，非源码）----
jsl_cookie_status.json
